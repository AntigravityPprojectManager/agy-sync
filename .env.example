# Project Manager API
PM_API=https://pm.wfh.day
PM_TOKEN=pm_your_api_token_here

# GitHub
GITHUB_TOKEN=ghp_your_github_token_here

# Workspace
WORKSPACE_ROOT=/Users/business/projects

# AI Provider (codex, gemini, or antigravity)
AI_PROVIDER=codex

# AI Model
TARGET_MODEL=gpt-5-codex

# Agent names
CONTRIBUTOR_AGENT_NAME=auto-contributor
REVIEWER_AGENT_NAME=auto-reviewer

# Registry file of managed repos
REGISTRY_FILE=./registry.tsv

# Paths to contributor/reviewer scripts
CONTRIBUTOR_SCRIPT=/Users/business/projects/project-contributor/contribute.sh
REVIEWER_SCRIPT=/Users/business/projects/project-reviewer/review.sh

# Cron interval (minutes)
INTERVAL_MINUTES=30
